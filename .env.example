# --- The Blenders Club — environment configuration ---
# Copy this file to .env.local and fill in real values before deploying.

# Site
NEXT_PUBLIC_SITE_URL=https://theblendersclub.com
NEXT_PUBLIC_BRAND_NAME="The Blenders Club"

# Ordering channels
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_ZOMATO_URL=https://www.zomato.com/your-city/the-blenders-club
NEXT_PUBLIC_SWIGGY_URL=https://www.swiggy.com/restaurants/the-blenders-club
# Deep-link scheme roots used to try opening native apps before falling back to the web URLs above.
NEXT_PUBLIC_ZOMATO_APP_SCHEME=zomato://restaurant/your-restaurant-id
NEXT_PUBLIC_SWIGGY_APP_SCHEME=swiggy://restaurant/your-restaurant-id

# Kitchen / contact (delivery-only cloud kitchen — no walk-in/dine-in)
NEXT_PUBLIC_STORE_ADDRESS="Cloud Kitchen Unit 4, Industrial Estate, Your City"
NEXT_PUBLIC_STORE_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_STORE_EMAIL=hello@theblendersclub.com
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.google.com/?q=The+Blenders+Club

# Analytics (leave blank to disable in development)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Database (server-only)
MONGODB_URI=
MONGODB_DB_NAME=blenders_club

# Auth (server-only) — generate your own with: openssl rand -base64 32
AUTH_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# WhatsApp Cloud API (server-only) — leave blank until Meta Business setup is done; notifications no-op safely when unset
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_TEMPLATE_ADMIN_NEW_ORDER=
WHATSAPP_TEMPLATE_CUSTOMER_STATUS_UPDATE=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en
